# Copy to .env and fill in. Never commit .env.
# Request Kafka access from Bitquery: https://docs.bitquery.io/docs/category/kafka-streams/

KAFKA_USERNAME=
KAFKA_PASSWORD=

# Optional overrides
# KAFKA_TOPIC=solana.transactions.proto
# KAFKA_BOOTSTRAP_SERVERS=rpk0.bitquery.io:9092,rpk1.bitquery.io:9092,rpk2.bitquery.io:9092
# KAFKA_CLIENT_ID=
# Stable group for resuming offsets; if unset, a unique group id is generated at startup.
# KAFKA_GROUP_ID=my-username-group-stable
# Read from oldest available offset when the group has no committed offset (default: false = latest only for new groups)
# KAFKA_FROM_BEGINNING=false
