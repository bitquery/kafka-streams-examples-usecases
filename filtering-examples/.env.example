# Bitquery Kafka (SCRAM-SHA-512, SASL_PLAINTEXT on port 9092 by default).
#
# KAFKA_USERNAME / KAFKA_PASSWORD are stream credentials (not IDE API keys).
# Request them from Bitquery support / sales: https://bitquery.io/forms/api
#
# Required: used by all scripts unless you override per chain below.
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password

# Optional: if your Solana and BSC streams use different Kafka logins, set these.
# Otherwise omit and the generic KAFKA_USERNAME / KAFKA_PASSWORD are used.
# KAFKA_USERNAME_SOLANA=
# KAFKA_PASSWORD_SOLANA=
# KAFKA_USERNAME_BSC=
# KAFKA_PASSWORD_BSC=
