# Copy to .env and fill in. Never commit .env.
#
# Kafka stream username / password — not IDE API keys.
# Obtain from Bitquery support / sales: https://bitquery.io/forms/api

KAFKA_USERNAME=
KAFKA_PASSWORD=

# Optional overrides (defaults match Python/Node examples)
# KAFKA_TOPIC=solana.transactions.proto
# KAFKA_BOOTSTRAP_SERVERS=rpk0.bitquery.io:9092,rpk1.bitquery.io:9092,rpk2.bitquery.io:9092
# KAFKA_GROUP_ID=my-stable-group
# latest | earliest
# KAFKA_AUTO_OFFSET_RESET=latest
